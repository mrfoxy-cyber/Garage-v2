@startuml
' diagram-id: parking-activity
' entities: operation:park
title Parking validation and assignment
start
:Receive non-null vehicle, garage, optional spot number;
if (Vehicle belongs to catalog?) then (yes)
else (no)
  :Return VehicleNotFound;
  stop
endif
if (Garage registered?) then (yes)
else (no)
  :Return ValidationFailed;
  stop
endif
if (Registration already parked in any garage?) then (yes)
  :Return VehicleAlreadyParked;
  stop
endif
if (Spot number supplied?) then (yes)
  :Use supplied spot number;
else (no)
  :Find first empty spot that fits vehicle;
  if (Suitable spot found?) then (yes)
    :Use matching spot number;
  else (no)
    :Return GarageFull or VehicleDoesNotFit;
    stop
  endif
endif
:Validate spot range, occupancy,\ndimensions and duplicate registration;
if (Validation successful?) then (yes)
  :ParkingSpot.Park(vehicle);
  :Return ParkingResult.Completed;
else (no)
  :Return ParkingResult.Failed with error code;
endif
stop
legend bottom
  Scope: GarageService.Park with non-null inputs; guards are summarized.
  [[../../interaction/sequence/parking-sequence.puml Parking sequence]]
  [[../state-machine/parking-spot-state.puml Spot state]]
endlegend
@enduml
